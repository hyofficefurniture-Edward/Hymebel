---
import MarketCategoryLayout from "../../layouts/MarketCategoryLayout.astro";
import { marketPages } from "../../data/market-pages";
import { categoriesFor } from "../../data/market-categories";
export function getStaticPaths() { return categoriesFor("ru", "ru").map((category) => ({ params: { category: category.slug }, props: { category } })); }
const { category } = Astro.props;
const href = `/ru/${category.slug}/`;
---
<MarketCategoryLayout copy={marketPages.ru} category={category} href={href} alternateHref={`/ru/en/${category.slug}/`} />

---
import "../styles/global.css";
import { company } from "../i18n/ui";

interface Props { market: "kz" | "uz"; localHref: string; localLabel: string; title: string; description: string; }
const { market, localHref, localLabel, title, description } = Astro.props;
const homeHref = market === "kz" ? "/kk/en/" : "/uz/en/";
const contactHref = market === "kz" ? "/kk/contact/" : "/uz/contact/";
const canonical = new URL(homeHref, Astro.site).href;
const country = market === "kz" ? "Kazakhstan" : "Uzbekistan";
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><link rel="alternate" hreflang="en-KZ" href={market === "kz" ? canonical : undefined} /><link rel="alternate" hreflang="en-UZ" href={market === "uz" ? canonical : undefined} /><link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site).href} /><meta property="og:type" content="website" /><meta property="og:site_name" content="Hymebel" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />{company.gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${company.gaId}`} />}{company.gaId && <script is:inline define:vars={{ gaId: company.gaId, market }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',gaId,{site:'hymebel',market:market,page_language:'en',content_group:'en'});</script>}</head><body><header class="navbar"><div class="nav-inner wrap-wide"><a class="brand" href={homeHref}><img class="brand__logo" src="/images/brand/hongye-logo.png" alt="Hongye Furniture Group logo" width="74" height="44" /><span class="brand__text"><span class="brand__name">Hymebel</span><span class="brand__tag">Hongye Furniture Group · {country}</span></span></a><nav class="nav market-nav"><a href={localHref} hreflang={market === "kz" ? "kk-KZ" : "uz-UZ"} class="lang-btn">{localLabel}</a></nav><a class="nav-cta" href={contactHref}>Project enquiry</a></div></header><main><section class="hero"><div class="wrap hero-grid"><div class="hero-content"><p class="eyebrow">{country} market</p><h1>{market === "kz" ? "Project furniture enquiries for Kazakhstan" : "Project furniture enquiries for Uzbekistan"}</h1><p>Share drawings, a BOQ, room schedule or procurement brief. The project team will clarify category scope, quantities and the next technical-commercial step for this market.</p><div class="hero-actions"><a href={contactHref} class="btn btn--primary">Send project enquiry</a></div></div><img src="/images/hero/hero-main.webp" alt="Hongye Furniture Group commercial furniture project" width="800" height="600" loading="eager" /></div></section><section class="section"><div class="wrap"><div class="card"><h2>Scope before promise</h2><p>Delivery, compliance documents, installation and commercial terms are reviewed against the specific project. This page does not make blanket timing, certification or logistics promises.</p></div></div></section></main><footer class="site-footer"><div class="footer-bottom"><div class="wrap footer-bottom-inner"><p>© {new Date().getFullYear()} Hongye Furniture Group</p></div></div></footer></body></html>

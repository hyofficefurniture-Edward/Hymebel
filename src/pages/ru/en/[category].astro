---
import MarketCategoryLayout from "../../../layouts/MarketCategoryLayout.astro";
import { marketPages } from "../../../data/market-pages";
import { categoriesFor } from "../../../data/market-categories";
export function getStaticPaths() { return categoriesFor("ru", "en").map((category) => ({ params: { category: category.slug }, props: { category } })); }
const { category } = Astro.props;
const href = `/ru/en/${category.slug}/`;
---
<MarketCategoryLayout copy={marketPages["ru-en"]} category={category} href={href} alternateHref={`/ru/${category.slug}/`} />

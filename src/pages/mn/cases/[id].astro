---
import Shell from '../../../layouts/RegionalShell.astro';
import Library from '../../../components/ProjectLibrary.astro';
import {marketPages} from '../../../data/market-pages';
import projects from '../../../data/project-library.json';
import copies from '../../../data/project-library-copy.json';
export function getStaticPaths(){return projects.map(c=>({params:{id:c.id},props:{c}}));}
const {c}=Astro.props;
---
<Shell copy={marketPages['mn']} title={c.name} description={c.name+" — "+c.country+". "+copies.mn[11]} href={'/mn/cases/'+c.id+'/'} alternateHref={'/mn/en/cases/'+c.id+'/'}><Library lang="mn" base="/mn/" id={c.id}/></Shell>

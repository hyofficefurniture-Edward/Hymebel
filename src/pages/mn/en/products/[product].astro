---
import RegionalProductLayout from '../../../../layouts/RegionalProductLayout.astro';
import {marketPages} from '../../../../data/market-pages';
import {catalogFor} from '../../../../data/market-catalog';
export function getStaticPaths(){return catalogFor('mn','en').map(p=>({params:{product:p.id}}));}
const {product}=Astro.params;
---
<RegionalProductLayout copy={marketPages["mn-en"]} id={product!} href={`/mn/en/products/${product}/`} alternateHref={`/mn/products/${product}/`}/>

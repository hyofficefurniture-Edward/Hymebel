---
import RegionalShell from './RegionalShell.astro';
import RegionalCatalog from '../components/RegionalCatalog.astro';
import productNotes from '../data/market-product-notes.json';
import { catalogFor, catalogGroups, regionalCopy } from '../data/market-catalog';
import type { MarketCopy } from './MarketLayout.astro';
interface Props {copy:MarketCopy;id:string;href:string;alternateHref:string;}
const {copy,id,href,alternateHref}=Astro.props;
if(copy.market!=='mn'&&copy.market!=='ru')throw new Error('Regional product market must be mn or ru');
if(copy.language!=='mn'&&copy.language!=='ru'&&copy.language!=='en')throw new Error('Unsupported regional product language');
const market=copy.market, language=copy.language;
const product=catalogFor(market,language).find(p=>p.id===id)!;
const detail=(productNotes as any)[id]?.[copy.language];
const gallery=detail?.imagePaths||product.gallery;
const group=catalogGroups.find(g=>g.slug===product.category)!;
const r=regionalCopy(market,language);
const labels=copy.language==='mn'?['Бүтээгдэхүүний төрөл','Захиалгын өмнө тодруулах','Хэмжээ ба материал','Тоо хэмжээ ба нийлүүлэлт']:copy.language==='ru'?['Направление','Что уточнить перед заказом','Размеры и материалы','Количество и поставка']:['Category','Review before ordering','Dimensions and materials','Quantity and supply'];
const specification=copy.language==='mn'?'Хэмжилттэй зураг, өнгөлгөө, бүрээс ба тоноглолын сонголтыг баталсан техникийн нөхцөлд оруулна.':copy.language==='ru'?'Габариты, отделка, обивка и фурнитура фиксируются в согласованной спецификации по чертежам.':'Dimensions, finish, upholstery and hardware are confirmed in the approved drawing-based specification.';
const quantity=copy.language==='mn'?'Өрөө бүрийн тоо ширхэг, хот, зорилтот огноо, савлагаа болон угсралтын хүрээг өгнө үү.':copy.language==='ru'?'Укажите количества по помещениям, город, даты, упаковку и состав работ по монтажу.':'Provide quantities by room, destination, target dates, packing and installation scope.';
const itemList={'@context':'https://schema.org','@type':'ItemList',name:group.title[language],itemListElement:catalogFor(market,language).filter(p=>p.category===product.category).map((p,i)=>({'@type':'ListItem',position:i+1,name:p.title,url:new URL(`${copy.homeHref}products/${p.id}/`,Astro.site).href}))};
---
<RegionalShell copy={copy} title={product.title} description={`${product.note} ${specification}`} href={href} alternateHref={alternateHref}>
<script slot="head" type="application/ld+json" set:html={JSON.stringify(itemList)}/>{detail?.questions&&<script slot="head" type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage",mainEntity:detail.questions.map((f:any)=>({"@type":"Question",name:f.q,acceptedAnswer:{"@type":"Answer",text:f.a}}))})}/>}
<section class="page-head"><div class="wrap"><p class="breadcrumb"><a href={copy.homeHref}>{copy.homeLabel}</a> / <a href={`${copy.homeHref}${product.category}/`}>{group.title[language]}</a> / {product.title}</p><h1>{product.title}</h1><p>{product.note}</p></div></section>
<section class="section"><div class="wrap"><div class="regional-brief"><div>{gallery.map((image:string,i:number)=><img src={image} alt={`${product.title} · ${i+1}`} width="800" height="600" loading={i===0?'eager':'lazy'} style="margin-bottom:18px"/>)}{detail?.caption&&<p class="regional-note">{detail.caption}</p>}</div><div><h2>{group.title[language]}</h2><p>{product.context}</p>{detail&&<><h3>{detail.focus}</h3><ul>{detail.items.map((item:string)=><li>{item}</li>)}</ul></>}{detail?.questions?.map((f:any)=><details style="margin:14px 0"><summary>{f.q}</summary><p>{f.a}</p></details>)}{detail?.sourceUrl&&<p><a href={detail.sourceUrl}>{detail.sourceLabel}</a></p>}{detail?.caseId&&<p><a href={`${copy.homeHref}cases/${detail.caseId}/`}>{detail.caseLabel}</a><br/>{detail.caseNote}</p>}<table class="regional-spec"><tbody><tr><th>{labels[0]}</th><td>{group.title[language]}</td></tr><tr><th>{labels[1]}</th><td>{group.checklist[language]}</td></tr><tr><th>{labels[2]}</th><td>{specification}</td></tr><tr><th>{labels[3]}</th><td>{quantity}</td></tr></tbody></table><p class="regional-note">{r.rangeNote}</p><p style="margin-top:24px"><a href={`${copy.contactHref}?product=${encodeURIComponent(id)}`} class="btn btn--primary">{copy.ctaLabel}</a></p><a href={`${copy.homeHref}project-starter/`}>{r.brief}</a></div></div></div></section>
<section class="section section--surface"><div class="wrap"><h2>{r.products}</h2><RegionalCatalog copy={copy} category={product.category}/></div></section>
</RegionalShell>

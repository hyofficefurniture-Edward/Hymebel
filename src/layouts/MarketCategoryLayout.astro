---
import RegionalShell from './RegionalShell.astro';
import RegionalCatalog from '../components/RegionalCatalog.astro';
import type { MarketCopy } from './MarketLayout.astro';
import type { MarketCategory } from '../data/market-categories';
import { regionalCopy } from '../data/market-catalog';
interface Props {copy:MarketCopy;category:MarketCategory;href:string;alternateHref:string;}
const {copy,category,href,alternateHref}=Astro.props;
const r=regionalCopy(copy.market,copy.language);
---
<RegionalShell copy={copy} title={category.title} description={category.description} href={href} alternateHref={alternateHref}>
<section class="page-head"><div class="wrap"><p class="breadcrumb"><a href={copy.homeHref}>{copy.homeLabel}</a> / {category.title}</p><h1>{category.title}</h1><p class="regional-intro">{category.intro}</p></div></section>
<section class="section"><div class="wrap"><h2>{r.products}</h2><RegionalCatalog copy={copy} category={category.slug}/><p class="regional-note">{r.rangeNote}</p></div></section>
<section class="section section--surface"><div class="wrap"><h2>{r.brief}</h2><ul class="list-check">{category.bullets.map(b=><li>{b}</li>)}</ul><p style="margin-top:24px"><a class="btn btn--primary" href={copy.contactHref}>{copy.ctaLabel}</a> <a class="btn btn--ghost" href={`${copy.homeHref}services/`}>{r.services}</a></p></div></section>
</RegionalShell>

---
import { alternates, localePath, marketEnglishEntry, useTranslations } from "../i18n/utils";
import { categories, about, contactPage } from "../data/categories";
import { company, languages, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { alts } = alternates(lang, "");
const englishEntry = marketEnglishEntry(lang);

const blogSlug = "blog";
const productLinks = categories.map((c) => ({ href: localePath(lang, c.slug), label: c.name[lang] }));
const companyLinks = [
  { href: localePath(lang), label: t("nav.home") },
  { href: localePath(lang, "cases"), label: t("nav.cases") },
  { href: localePath(lang, about.slug), label: about.name[lang] },
  { href: localePath(lang, about.slug) + "#factory", label: t("footer.factory") },
  { href: localePath(lang, contactPage.slug), label: t("nav.contact") },
];
const resourceLinks = [
  { href: localePath(lang, blogSlug), label: t("nav.blog") },
  { href: localePath(lang, contactPage.slug), label: t("hero.ctaPrimary") },
];
---

<footer class="site-footer">
  <div class="footer-cta">
    <div class="wrap footer-cta-inner">
      <span class="footer-cta-tag">{t("footer.cta.tag")}</span>
      <div class="footer-cta-content">
        <h2>{t("footer.cta.title")}</h2>
        <p>{t("footer.cta.body")}</p>
      </div>
      <div class="footer-cta-actions">
        <a href={localePath(lang, contactPage.slug)} class="btn btn--primary">{t("hero.ctaPrimary")}</a>
        <a href={localePath(lang, categories[0].slug)} class="btn btn--light">{t("footer.cta.secondary")}</a>
      </div>
    </div>
  </div>

  <div class="wrap footer-top">
    <div class="footer-brand">
      <a href={localePath(lang)} class="footer-logo-link">
        <img
          class="footer-logo-img"
          src="/images/brand/hongye-fenmi-group.jpg"
          alt={lang === "kk"
            ? "Hongye Furniture Group (коммерциялық жиһаз) және Fenmi Casa (тұрғын үй жиһазы) логотиптері"
            : lang === "uz"
              ? "Hongye Furniture Group (tijorat mebeli) va Fenmi Casa (turar-joy mebeli) logotiplari"
              : "Hongye Furniture Group (commercial furniture) and Fenmi Casa (residential furniture) logos"}
          width="150"
          height="140"
          loading="lazy"
        />
      </a>
      <p class="footer-tagline">{t("footer.about")}</p>
      <div class="footer-social">
        <a href={`https://wa.me/${company.whatsapp}`} class="social-link" aria-label="WhatsApp" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.122.552 4.109 1.521 5.837L.041 23.625a.5.5 0 0 0 .617.617l5.788-1.48A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.884 0-3.659-.497-5.195-1.367l-.37-.217-3.838.982.998-3.744-.234-.388A10 10 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@HYSD888888" class="social-link" aria-label="TikTok" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </a>
        <a href="https://www.instagram.com/HYSD9681986/" class="social-link" aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5"/></svg>
        </a>
        <a href="https://www.youtube.com/@hongyefurnituresolution" class="social-link" aria-label="YouTube" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20.06 12 20.06 12 20.06s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon fill="#0F1419" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
        </a>
      </div>
    </div>

    <div class="footer-links">
      <div class="footer-col">
        <h4 class="footer-col-title">{t("footer.col.products")}</h4>
        {productLinks.map((p) => <a href={p.href} class="footer-link">{p.label}</a>)}
      </div>
      <div class="footer-col">
        <h4 class="footer-col-title">{t("footer.col.company")}</h4>
        {companyLinks.map((p) => <a href={p.href} class="footer-link">{p.label}</a>)}
      </div>
      <div class="footer-col">
        <h4 class="footer-col-title">{t("footer.col.resources")}</h4>
        {resourceLinks.map((p) => <a href={p.href} class="footer-link">{p.label}</a>)}
      </div>
      <div class="footer-col">
        <h4 class="footer-col-title">{t("footer.col.contact")}</h4>
        <p class="footer-info">📧 {company.email}</p>
        <p class="footer-info">📱 WhatsApp {company.whatsapp}</p>
        <p class="footer-info">📍 Guangdong, China</p>
        <div class="lang-switch" role="group" aria-label="Language">
          {alts.map((alt) => <a href={alt.href} hreflang={alt.hreflang} class="lang-btn">{languages[alt.lang].short}</a>)}
          {englishEntry && <a href={englishEntry} hreflang="en" class="lang-btn">EN</a>}
        </div>
      </div>
    </div>
  </div>

  <div class="hy-group-member">
    <a href="https://hysdfurniture.com/about/" target="_blank" rel="noopener">{t("footer.member")}</a>
  </div>

  <div class="footer-bottom">
    <div class="wrap footer-bottom-inner">
      <p>{t("footer.rights")}</p>
    </div>
  </div>
</footer>

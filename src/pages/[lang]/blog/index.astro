---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { localePath, useTranslations } from "../../../i18n/utils";
import { posts } from "../../../data/blog";
import { locales, type Lang } from "../../../i18n/ui";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const list = posts;
---

<BaseLayout
  lang={lang}
  title={`${t("blog.title")} · Hymebel`}
  description={t("blog.subtitle").slice(0, 158)}
  slug="blog"
  ogImage={list[0]?.image}
  breadcrumb={[{ name: t("blog.title"), href: localePath(lang, "blog") }]}
>
  <section class="page-head">
    <div class="wrap">
      <p class="breadcrumb">
        <a href={localePath(lang)}>{t("nav.home")}</a> / {t("blog.title")}
      </p>
      <h1>{t("blog.title")}</h1>
      <p class="section__lead">{t("blog.subtitle")}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="grid grid--3" style="margin-top:8px">
        {list.map((p) => (
          <a class="blog-card blog-card--visual" href={localePath(lang, `blog/${p.id}`)}>
            <img class="blog-card__img" src={p.image} alt={p.imageAlt[lang]} loading="lazy" width="800" height="450" />
            <div class="blog-card__body">
              <div class="blog-card__tag">{p.tag[lang]}</div>
              <div class="blog-card__title">{p.title[lang]}</div>
              <p class="blog-card__excerpt">{p.excerpt[lang]}</p>
              <div class="blog-card__meta">{p.date} · {p.readingMin} min</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>{t("cta.title")}</h2>
      <p>{t("cta.body")}</p>
      <a class="btn btn--ghost" href={localePath(lang, "contact")}>{t("hero.ctaPrimary")}</a>
    </div>
  </section>
</BaseLayout>

---
import "../styles/global.css";
import { company } from "../i18n/ui";
import type { MarketCopy } from "./MarketLayout.astro";

type ResourceKind = "project-starter" | "faq";
interface Props { copy: MarketCopy; kind: ResourceKind; href: string; alternateHref: string; }
const { copy, kind, href, alternateHref } = Astro.props;
const isStarter = kind === "project-starter";
const alternateLang = copy.market === "mn" ? (copy.language === "en" ? "mn-MN" : "en-MN") : (copy.language === "en" ? "ru-RU" : "en-RU");
const canonical = new URL(href, Astro.site).href;
const content = copy.language === "mn"
  ? {
      starterTitle: "Төслийн эхлүүлэх хуудас", starterDesc: "Төслийн тавилгын асуулгыг BOQ, зураг, өрөөний жагсаалтаар бэлтгэх Монголын хуудас.", starterLead: "Зураг бүрэн бэлэн биш байсан ч доорх мэдээллийг цуглуулж эхэлж болно. Бид мэдээллийг төслийн хүрээг тодруулахад л ашиглана.", faqTitle: "Төслийн асуулт, хариулт", faqDesc: "Монголын төслийн тавилгын асуулга, материал, BOQ, техникийн тодруулгын асуултууд.", resourceLabel: "Төслийн бриф", faqLabel: "Түгээмэл асуулт", fields: ["Төслийн нэр ба хот", "Барилгын төрөл / ашиглалт", "Өрөөний жагсаалт", "Тоо ширхэг ба зорилтот огноо", "BOQ, зураг эсвэл файлын холбоос", "Материал/өнгөний жишээ"], faq: [["Зураггүйгээр эхэлж болох уу?", "Болно. Өрөөний жагсаалт, ойролцоох тоо хэмжээ, лавлах зураг болон зорилтот огноо нь эхний техникийн ярилцлагад хангалттай."], ["Ямар файл хэрэгтэй вэ?", "BOQ, төлөвлөлт, PDF, CAD экспорт эсвэл үүлэн файлын холбоос явуулж болно. Файлын хүртээмж болон нууцлалын нөхцөлийг илгээхээсээ өмнө шалгана уу."], ["Хэзээ үнэ, хугацаа батлагдах вэ?", "Техникийн шаардлага, тоо хэмжээ, материал, зорьсон улс ба төслийн хуваарийг нягталсны дараа тус бүрээр нь батална."], ["Гэрчилгээ, суурилуулалт, логистикийг амлаж болох уу?", "Үгүй. Эдгээр нь бүтээгдэхүүн, очих газар болон гэрээний нөхцлөөс шалтгаалж төслөөр нь шалгагдана."]], submit: "Төслийн бриф илгээх", message: "Доорх мэдээлэл, файлын холбоос эсвэл асуултаа бичнэ үү" }
  : copy.language === "ru"
    ? {
        starterTitle: "Старт проекта", starterDesc: "Страница подготовки запроса по проектной мебели в России: BOQ, чертежи и ведомость помещений.", starterLead: "Даже если чертежи ещё не готовы, начните со списка ниже. Информация нужна только для уточнения рамок конкретного проекта.", faqTitle: "Вопросы по проектному запросу", faqDesc: "Ответы о BOQ, материалах, чертежах и техническом уточнении мебельного проекта в России.", resourceLabel: "Бриф проекта", faqLabel: "Вопросы и ответы", fields: ["Название проекта и город", "Тип объекта / сценарий использования", "Ведомость помещений", "Количество и целевая дата", "BOQ, чертежи или ссылка на файл", "Примеры материалов / отделок"], faq: [["Можно начать без готовых чертежей?", "Да. Для первого технического обсуждения достаточно ведомости помещений, ориентировочных количеств, референсов и целевой даты."], ["Какие файлы можно отправить?", "Подойдут BOQ, планировки, PDF, экспорт CAD или ссылка на облачный файл. До отправки проверьте права доступа и условия конфиденциальности."], ["Когда подтверждаются цена и сроки?", "Они подтверждаются отдельно после проверки технических требований, количества, материалов, страны назначения и графика проекта."], ["Можно ли заранее обещать сертификаты, монтаж или логистику?", "Нет. Это проверяется для конкретного товара, страны назначения и условий договора."]], submit: "Отправить бриф", message: "Опишите проект, добавьте ссылку на файлы или вопросы" }
    : {
        starterTitle: "Project starter", starterDesc: "Prepare a project-furniture enquiry with a BOQ, drawings and room list.", starterLead: "Start with the information below even when drawings are not final. It is used only to clarify the scope of the specific project.", faqTitle: "Project enquiry FAQ", faqDesc: "Answers about BOQs, drawings, materials and technical clarification for a project-furniture enquiry.", resourceLabel: "Project brief", faqLabel: "FAQ", fields: ["Project name and city", "Building type / use case", "Room schedule", "Quantities and target date", "BOQ, drawings or file link", "Material / finish references"], faq: [["Can we start without final drawings?", "Yes. A room list, approximate quantities, reference images and target date are enough for a first technical discussion."], ["Which files can we share?", "A BOQ, plans, PDF, CAD export or cloud-file link are useful. Check access permission and confidentiality conditions before sending."], ["When are price and timing confirmed?", "They are confirmed for the individual project after technical requirements, quantities, materials, destination and schedule are reviewed."], ["Can certifications, installation or logistics be promised in advance?", "No. These are reviewed for the relevant product, destination and contract conditions."]], submit: "Send project brief", message: "Describe the project, add a file link or ask your questions" };
const title = isStarter ? content.starterTitle : content.faqTitle;
const description = isStarter ? content.starterDesc : content.faqDesc;
const faqJsonLd = !isStarter ? { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: content.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) } : null;
---
<!doctype html><html lang={copy.htmlLang} dir="ltr"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title} | Hymebel</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><link rel="alternate" hreflang={copy.htmlLang} href={canonical} /><link rel="alternate" hreflang={alternateLang} href={new URL(alternateHref, Astro.site).href} /><link rel="alternate" hreflang="x-default" href={new URL(copy.homeHref, Astro.site).href} /><meta property="og:type" content="website" /><meta property="og:site_name" content="Hymebel" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />{faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}{company.gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${company.gaId}`} />}{company.gaId && <script is:inline define:vars={{ gaId: company.gaId, market: copy.market, language: copy.language, kind }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',gaId,{site:'hymebel',market:market,page_language:language,content_group:kind});window.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('form[action*="web3forms"]').forEach(function(f){f.addEventListener('submit',function(){gtag('event','generate_lead',{site:'hymebel',market:market,page_language:language,content_group:kind,form_id:'project_starter'})})})});</script>}</head><body><header class="navbar"><div class="nav-inner wrap-wide"><a class="brand" href={copy.homeHref}><img class="brand__logo" src="/images/brand/hongye-logo.png" alt="Hongye Furniture Group logo" width="74" height="44" /><span class="brand__text"><span class="brand__name">Hymebel</span><span class="brand__tag">{copy.brandLine}</span></span></a><nav class="nav market-nav"><a class="nav-link" href={copy.homeHref}>{copy.homeLabel}</a><a class="nav-link" href={`${copy.homeHref}project-starter/`}>{content.resourceLabel}</a><a class="lang-btn" href={copy.pairedHref} hreflang={alternateLang}>{copy.pairedLabel}</a></nav><a class="nav-cta" href={copy.contactHref}>{copy.contactLabel}</a></div></header><main><section class="page-head"><div class="wrap"><p class="breadcrumb"><a href={copy.homeHref}>{copy.homeLabel}</a> / {title}</p><h1>{title}</h1><p class="prose">{isStarter ? content.starterLead : description}</p></div></section>{isStarter ? <section class="section"><div class="wrap"><div class="card"><h2>{content.resourceLabel}</h2><ol class="process-list">{content.fields.map((item) => <li>{item}</li>)}</ol></div><form class="form" action="https://api.web3forms.com/submit" method="POST"><input type="hidden" name="access_key" value={company.web3formsKey} /><input type="hidden" name="subject" value={`Hymebel ${copy.market.toUpperCase()} project starter`} /><input type="hidden" name="from_name" value="hymebel.com" /><input type="hidden" name="content_cluster" value="project-starter" /><input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" /><label>{copy.nameLabel}<input type="text" name="name" required /></label><label>{copy.companyLabel}<input type="text" name="company" /></label><label>{copy.countryLabel}<input type="text" name="country" required /></label><label>{copy.phoneLabel}<input type="text" name="phone" required /></label><label class="full">{content.message}<textarea name="message" rows="7" required></textarea></label><div class="full"><button class="btn btn--primary" type="submit">{content.submit}</button></div></form></div></section> : <section class="section"><div class="wrap">{content.faq.map(([q,a]) => <article class="card" style="margin-bottom:16px"><h2>{q}</h2><p>{a}</p></article>)}<p><a href={`${copy.homeHref}project-starter/`} class="btn btn--primary">{content.resourceLabel}</a></p></div></section>}</main><footer class="site-footer"><div class="footer-bottom"><div class="wrap footer-bottom-inner"><p>© {new Date().getFullYear()} Hongye Furniture Group</p></div></div></footer></body></html>

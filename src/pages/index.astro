---
/**
 * Root path stays with the Central Asia default (Kazakh). MN/RU are separate
 * direct-entry markets, so neither is presented on the KK/UZ/EN root path.
 * A CDN 301 may be configured later; this works on every static host.
 */
const SITE = "https://hymebel.com";
const target = `${SITE}/kk/`;
---

<!doctype html>
<html lang="kk-KZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hymebel — Қазақша нұсқаға өту</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={target} />
    <link rel="alternate" hreflang="kk-KZ" href={target} />
    <link rel="alternate" hreflang="uz-UZ" href={`${SITE}/uz/`} />
    <link rel="alternate" hreflang="en" href={`${SITE}/en/`} />
    <link rel="alternate" hreflang="x-default" href={target} />
    <meta http-equiv="refresh" content="0; url=/kk/" />
  </head>
  <body>
    <p><a href="/kk/">Қазақша нұсқаға өту →</a> · <a href="/uz/">Oʻzbekcha</a> · <a href="/en/">English</a></p>
  </body>
</html>

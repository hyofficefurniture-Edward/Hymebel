---
import { catalogGroups, regionalCopy } from '../data/market-catalog';
import RegionalCatalog from './RegionalCatalog.astro';
import type { MarketCopy } from '../layouts/MarketLayout.astro';
const {copy}=Astro.props as {copy:MarketCopy};
const r=regionalCopy(copy.market,copy.language);
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:r.faqItems.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}/>
<section class="section"><div class="wrap"><p class="regional-intro">{r.definition}</p></div></section>
<section id="products" class="section section--surface"><div class="wrap"><h2>{r.products}</h2><p class="section__lead">{r.productLead}</p><div class="grid grid--3 regional-grid">{catalogGroups.map(g=><article class="card card--visual"><a href={`${copy.homeHref}${g.slug}/`}><img class="card__img" src={g.image} alt={g.title[copy.language]} width="800" height="600" loading="lazy"/></a><div class="card__body"><h3>{g.title[copy.language]}</h3><p>{g[copy.language==='en'?'en':copy.market]}</p><a class="card__link" href={`${copy.homeHref}${g.slug}/`}>{r.read}</a></div></article>)}</div></div></section>
<section class="section"><div class="wrap"><h2>{copy.language==='mn'?'Сонгосон бүтээгдэхүүн':copy.language==='ru'?'Изделия для комплектации':'Selected furniture'}</h2><RegionalCatalog copy={copy} limit={6}/><p class="regional-note">{r.rangeNote}</p></div></section>
<section id="services" class="section section--surface"><div class="wrap"><h2>{r.services}</h2><p class="section__lead">{r.serviceLead}</p><div class="regional-services">{r.servicesList.map(([title,body])=><article><h3>{title}</h3><p>{body}</p></article>)}</div><p style="margin-top:24px"><a class="btn btn--ghost" href={`${copy.homeHref}services/`}>{r.read}</a></p></div></section>
<section class="section"><div class="wrap"><h2>{r.cases}</h2><p class="section__lead">{r.casesLead}</p><div class="grid grid--3 regional-grid">{r.caseItems.map(c=><article class="card card--visual"><img class="card__img" src={c.image} alt={c.title} width="800" height="600" loading="lazy"/><div class="card__body"><h3>{c.title}</h3><p>{c.body}</p></div></article>)}</div><p style="margin-top:24px"><a class="btn btn--ghost" href={`${copy.homeHref}cases/`}>{r.cases}</a></p></div></section>
<section class="section section--surface"><div class="wrap"><h2>{r.about}</h2><p class="regional-intro">{r.factoryBody}</p><div class="regional-gallery">{['cnc','assembly','quality-control'].map((file,i)=><figure><img src={`/images/fabrica/${file}.webp`} alt={r.factoryCaptions[i]} width="800" height="600" loading="lazy"/><figcaption>{r.factoryCaptions[i]}</figcaption></figure>)}</div><p style="margin-top:24px"><a class="btn btn--ghost" href={`${copy.homeHref}about/`}>{r.read}</a></p></div></section>
<section class="section"><div class="wrap"><h2>{r.processTitle}</h2><div class="steps regional-grid">{r.process.map((step,i)=><div class="step"><strong>{String(i+1).padStart(2,'0')}</strong><p>{step}</p></div>)}</div></div></section>
<section class="section section--surface"><div class="wrap"><h2>{r.faq}</h2><div class="faq-grid">{r.faqItems.map(([q,a])=><details class="faq"><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
<section class="cta-band"><div class="wrap"><h2>{copy.formTitle}</h2><p>{copy.language==='mn'?'Зураг, BOQ, тоо ширхэг, материалын жишээ болон зорилтот огноогоо хуваалцаарай.':copy.language==='ru'?'Передайте чертежи, BOQ, количества, референсы отделок и целевые даты.':'Share drawings, BOQ, quantities, finish references and target dates.'}</p><a class="btn btn--ghost" href={`${copy.homeHref}project-starter/`}>{r.brief}</a> <a class="btn btn--ghost" href={copy.contactHref}>{copy.ctaLabel}</a></div></section>

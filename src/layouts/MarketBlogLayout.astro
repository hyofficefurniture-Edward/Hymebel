---
import "../styles/global.css";
import "../styles/regional.css";
import RegionalHeader from '../components/RegionalHeader.astro';
import RegionalFooter from '../components/RegionalFooter.astro';
import type { MarketCopy } from "./MarketLayout.astro";
import type { MarketPost } from "../data/market-posts";
import { company } from "../i18n/ui";
interface Props { copy: MarketCopy; post?: MarketPost; }
const { copy, post } = Astro.props;
const pointsLabel = copy.language === 'mn' ? 'Гол санаанууд' : copy.language === 'ru' ? 'Ключевые выводы' : 'Key points';
const faqLabel = copy.language === 'mn' ? 'Асуулт, хариулт' : copy.language === 'ru' ? 'Вопросы и ответы' : 'FAQ';
const faqJsonLd = post ? { '@context':'https://schema.org', '@type':'FAQPage', mainEntity:post.faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}})) } : null;
const local = copy.language !== "en";
const blogHref = `${copy.homeHref}blog/`;
const pairedBase = copy.pairedHref;
const pairedHref = post ? `${pairedBase}blog/${post.id}/` : `${pairedBase}blog/`;
const selfHref = post ? `${blogHref}${post.id}/` : blogHref;
const title = post ? post.title : (local ? (copy.market === "mn" ? "Төслийн тавилгын мэдлэг" : "База знаний о мебели для проектов") : "Project furniture knowledge");
const description = post ? post.excerpt : (local ? (copy.market === "mn" ? "Монголын төслийн тавилгын асуулга, BOQ, өрөөний жагсаалт ба техникийн бэлтгэлийн нийтлэлүүд." : "Материалы для подготовки мебельного проекта в России: BOQ, чертежи, ведомость помещений и технические вопросы.") : "Articles for preparing a project-furniture enquiry with BOQs, drawings and room schedules.");
const alternateLang = copy.market === "mn" ? (local ? "en-MN" : "mn-MN") : (local ? "en-RU" : "ru-RU");
const articleJsonLd = post ? { "@context": "https://schema.org", "@type": "Article", headline: post.title, description: post.excerpt, datePublished: post.date, dateModified: post.date, image: `https://hymebel.com${post.image}`, author: { "@type": "Organization", name: "Hymebel Editorial Team · Hongye Furniture Group" }, publisher: { "@type": "Organization", name: "Hongye Furniture Group" }, inLanguage: copy.htmlLang } : null;
---
<!doctype html><html lang={copy.htmlLang}><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title} | Hymebel</title><meta name="description" content={description} /><link rel="canonical" href={new URL(selfHref, Astro.site).href} /><link rel="alternate" hreflang={copy.htmlLang} href={new URL(selfHref, Astro.site).href} />{!post && <link rel="alternate" hreflang={alternateLang} href={new URL(pairedHref, Astro.site).href} />}<link rel="alternate" hreflang="x-default" href={new URL(copy.homeHref, Astro.site).href} /><meta property="og:type" content={post ? "article" : "website"} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />{articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}{company.gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${company.gaId}`} />}{company.gaId && <script is:inline define:vars={{ gaId: company.gaId, market: copy.market, language: copy.language, contentGroup: post ? "market_article" : "market_blog" }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',gaId,{site:'hymebel',market:market,page_language:language,content_group:contentGroup});</script>}{faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}/>}</head><body><RegionalHeader copy={copy}/><main><section class="page-head"><div class="wrap"><p class="breadcrumb"><a href={copy.homeHref}>{copy.homeLabel}</a> / {post && <a href={blogHref}>Blog</a>} {post ? ` / ${post.tag}` : " / Blog"}</p><h1>{title}</h1><p class="prose">{description}</p></div></section>{post ? <article class="section"><div class="wrap prose-article"><img src={post.image} alt={post.imageAlt} width="1200" height="675" loading="eager" /><p class="lead">{post.definition}</p><h2>{pointsLabel}</h2><ul>{post.takeaways.map((item) => <li>{item}</li>)}</ul>{post.sections.map((section) => <section><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}<h2>{faqLabel}</h2>{post.faqs.map((faq) => <section><h3>{faq.question}</h3><p>{faq.answer}</p></section>)}</div></article> : <slot />}{post && <section class="cta-band"><div class="wrap"><h2>{copy.formTitle}</h2><p>{copy.heroBody}</p><a href={copy.contactHref} class="btn btn--ghost">{copy.ctaLabel}</a></div></section>}</main><RegionalFooter copy={copy}/></body></html>

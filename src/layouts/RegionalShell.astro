---
import '../styles/global.css';
import '../styles/regional.css';
import RegionalHeader from '../components/RegionalHeader.astro';
import RegionalFooter from '../components/RegionalFooter.astro';
import { company } from '../i18n/ui';
import type { MarketCopy } from './MarketLayout.astro';
interface Props {copy:MarketCopy;title:string;description:string;href:string;alternateHref:string;}
const {copy,title,description,href,alternateHref}=Astro.props;
const canonical=new URL(href,Astro.site).href;
const pairedLang=copy.language==='en'?(copy.market==='mn'?'mn-MN':'ru-RU'):(copy.market==='mn'?'en-MN':'en-RU');
const schema={ '@context':'https://schema.org','@type':'WebPage',name:title,description,url:canonical,inLanguage:copy.htmlLang,about:{'@type':'Organization',name:'Hongye Furniture Group',alternateName:'Hymebel',url:'https://hymebel.com/',email:company.email},breadcrumb:{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:copy.homeLabel,item:new URL(copy.homeHref,Astro.site).href},{'@type':'ListItem',position:2,name:title,item:canonical}]}};
---
<!doctype html><html lang={copy.htmlLang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | Hymebel</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang={copy.htmlLang} href={canonical}/><link rel="alternate" hreflang={pairedLang} href={new URL(alternateHref,Astro.site).href}/><link rel="alternate" hreflang="x-default" href={new URL(copy.homeHref,Astro.site).href}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/><slot name="head"/>
{company.gaId&&<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${company.gaId}`}/>}{company.gaId&&<script is:inline define:vars={{gaId:company.gaId,market:copy.market,language:copy.language}}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',gaId,{site:'hymebel',market:market,page_language:language});</script>}
</head><body><RegionalHeader copy={copy}/><main><slot/></main><RegionalFooter copy={copy}/></body></html>

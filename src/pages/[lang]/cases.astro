---
import Layout from '../../layouts/BaseLayout.astro';
import Library from '../../components/ProjectLibrary.astro';
import copies from '../../data/project-library-copy.json';
import {locales,type Lang} from '../../i18n/ui';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const {lang}=Astro.params as {lang:Lang};
---
<Layout lang={lang} title={copies[lang][0]} description={copies[lang][25]} slug="cases"><Library lang={lang} base={'/'+lang+'/'} /></Layout>

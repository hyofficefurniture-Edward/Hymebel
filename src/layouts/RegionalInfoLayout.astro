---
import RegionalShell from './RegionalShell.astro';
import { regionalCopy } from '../data/market-catalog';
import type { MarketCopy } from './MarketLayout.astro';
interface Props {copy:MarketCopy;kind:'cases'|'services'|'about';href:string;alternateHref:string;}
const {copy,kind,href,alternateHref}=Astro.props;
const r=regionalCopy(copy.market,copy.language);
const title=r[kind];
const lead=kind==='cases'?r.casesLead:kind==='services'?r.serviceLead:r.factoryBody;
---
<RegionalShell copy={copy} title={title} description={lead} href={href} alternateHref={alternateHref}>
  <section class="page-head"><div class="wrap"><p class="breadcrumb"><a href={copy.homeHref}>{copy.homeLabel}</a> / {title}</p><h1>{title}</h1><p class="regional-intro">{lead}</p></div></section>
  {kind==='cases'&&<section class="section"><div class="wrap"><div class="grid grid--3">{r.caseItems.map(c=><article class="card card--visual"><img class="card__img" src={c.image} alt={c.title} width="800" height="600" loading="lazy"/><div class="card__body"><h2>{c.title}</h2><p>{c.body}</p></div></article>)}</div><p class="regional-note">{copy.language==='mn'?'Танай төслийн зураг, багцын хүрээтэй ижил жишээ авахыг хүсвэл зориулалт, материал, хэмжээгээ илгээнэ үү.':copy.language==='ru'?'Чтобы запросить релевантный вашему объекту пример, укажите тип помещений, состав мебели и отделки.':'Request a relevant reference with your room types, furniture scope and finish preferences.'}</p></div></section>}
  {kind==='services'&&<><section class="section"><div class="wrap"><div class="regional-services">{r.servicesList.map(([name,body])=><article><h2>{name}</h2><p>{body}</p></article>)}</div></div></section><section class="section section--surface"><div class="wrap"><h2>{r.processTitle}</h2><div class="steps regional-grid">{r.process.map((step,i)=><div class="step"><strong>{i+1}</strong><p>{step}</p></div>)}</div><p class="regional-note">{copy.language==='mn'?'Нийлүүлэх бараа, баримт бичиг, тээвэр, угсралтын хариуцлагыг тусад нь тохирч гэрээнд тусгана.':copy.language==='ru'?'Состав поставки, документы, транспорт и монтаж выделяются отдельно и подтверждаются в договоре.':'Supply scope, documentation, transport and installation responsibilities are agreed separately in the contract.'}</p></div></section></>}
  {kind==='about'&&<><section class="section"><div class="wrap"><div class="regional-brief"><img src="/images/fabrica/hq-building.webp" alt="Hongye Furniture Group" width="800" height="600" loading="lazy"/><div><h2>Hongye Furniture Group · Hymebel</h2><p>{r.definition}</p><p>{copy.language==='mn'?'Үйлдвэрийн байршил: Жянмэнь, Гуандун, Хятад. Монголын хуудас нь орон нутгийн үйлдвэр эсвэл салбарын баталгаа биш; төслийн хүсэлтийг үйлдвэрийн багтай холбох суваг юм.':copy.language==='ru'?'Производственная база: Цзянмэнь, Гуандун, Китай. Российская страница связывает проектную команду с производителем; она не обозначает местный завод или подтверждённый филиал.':'Production base: Jiangmen, Guangdong, China. This regional page connects project teams with the manufacturer and does not imply a local factory or branch.'}</p></div></div><div class="regional-gallery">{['cnc','assembly','quality-control'].map((file,i)=><figure><img src={`/images/fabrica/${file}.webp`} alt={r.factoryCaptions[i]} width="800" height="600" loading="lazy"/><figcaption>{r.factoryCaptions[i]}</figcaption></figure>)}</div></div></section></>}
  <section class="cta-band"><div class="wrap"><h2>{copy.formTitle}</h2><p>{r.productLead}</p><a class="btn btn--ghost" href={copy.contactHref}>{copy.ctaLabel}</a> <a class="btn btn--ghost" href={`${copy.homeHref}project-starter/`}>{r.brief}</a></div></section>
</RegionalShell>

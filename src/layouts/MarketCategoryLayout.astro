---
import "../styles/global.css";
import { company } from "../i18n/ui";
import type { MarketCopy } from "./MarketLayout.astro";
import type { MarketCategory } from "../data/market-categories";

interface Props { copy: MarketCopy; category: MarketCategory; href: string; alternateHref: string; }
const { copy, category, href, alternateHref } = Astro.props;
const alternateLang = copy.market === "mn" ? (copy.language === "en" ? "mn-MN" : "en-MN") : (copy.language === "en" ? "ru-RU" : "en-RU");
const canonical = new URL(href, Astro.site).href;
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: copy.homeLabel, item: new URL(copy.homeHref, Astro.site).href },
    { "@type": "ListItem", position: 2, name: category.title, item: canonical },
  ],
};
const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: category.title,
  description: category.description,
  inLanguage: copy.htmlLang,
  url: canonical,
  isPartOf: { "@type": "WebSite", name: "Hymebel", url: Astro.site?.origin ?? "https://hymebel.com" },
};
const blogLabel = copy.language === "mn" ? "Нийтлэл" : copy.language === "ru" ? "Статьи" : "Insights";
---
<!doctype html>
<html lang={copy.htmlLang} dir="ltr"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{category.title} | Hymebel</title><meta name="description" content={category.description} /><link rel="canonical" href={canonical} /><link rel="alternate" hreflang={copy.htmlLang} href={canonical} /><link rel="alternate" hreflang={alternateLang} href={new URL(alternateHref, Astro.site).href} /><link rel="alternate" hreflang="x-default" href={new URL(copy.homeHref, Astro.site).href} /><meta property="og:type" content="website" /><meta property="og:site_name" content="Hymebel" /><meta property="og:title" content={category.title} /><meta property="og:description" content={category.description} /><meta property="og:url" content={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} /><script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />{company.gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${company.gaId}`} />}{company.gaId && <script is:inline define:vars={{ gaId: company.gaId, market: copy.market, language: copy.language }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',gaId,{site:'hymebel',market:market,page_language:language,content_group:language});</script>}</head><body><header class="navbar"><div class="nav-inner wrap-wide"><a class="brand" href={copy.homeHref}><img class="brand__logo" src="/images/brand/hongye-logo.png" alt="Hongye Furniture Group logo" width="74" height="44" /><span class="brand__text"><span class="brand__name">Hymebel</span><span class="brand__tag">{copy.brandLine}</span></span></a><nav class="nav market-nav"><a href={copy.homeHref} class="nav-link">{copy.homeLabel}</a><a href={`${copy.homeHref}blog/`} class="nav-link">{blogLabel}</a><a href={copy.pairedHref} class="lang-btn" hreflang={alternateLang}>{copy.pairedLabel}</a></nav><a class="nav-cta" href={copy.contactHref}>{copy.contactLabel}</a></div></header><main><section class="page-head"><div class="wrap"><p class="breadcrumb"><a href={copy.homeHref}>{copy.homeLabel}</a> / {category.title}</p><h1>{category.title}</h1><p class="prose">{category.intro}</p></div></section><section class="section"><div class="wrap"><div class="card"><ul class="prose">{category.bullets.map((bullet) => <li>{bullet}</li>)}</ul><p><a href={copy.contactHref} class="btn btn--primary">{copy.ctaLabel}</a></p></div></div></section></main><footer class="site-footer"><div class="footer-bottom"><div class="wrap footer-bottom-inner"><p>© {new Date().getFullYear()} Hongye Furniture Group</p></div></div></footer></body></html>
